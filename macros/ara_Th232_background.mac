/gps/source/list
# Tell GPS to randomly pick a source each event (weighted by intensity)
/gps/source/multiplevertex false
#
/analysis/setFileName /rcfs/projects/dunelb/jime782/sndwrm/build/Th232Gammas.root
# Set histogram binning
/analysis/h1/set 0 100 0. 2. MeV
/analysis/h1/set 1 100 0. 2. MeV
/analysis/h1/set 6 100 0. 2. MeV
/analysis/ntuple/setActivation 0 true
/analysis/ntuple/setActivation 1 true
/analysis/ntuple/setActivation 2 true
# tracks
/analysis/ntuple/setActivation 3 false
# stepping
/analysis/ntuple/setActivation 4 false
#
/run/printProgress 5
# ~5800 events corresponds to one supernova 10s time window
/run/beamOn 1000
