#
#
/control/verbose 2
/run/verbose 0
/tracking/verbose 0
#
# set the target/detector geometry
/sndwrm/det/setGDMLfile /rcfs/projects/dunelb/jime782/duneggd/python/duneggd/apexfd/duneapex.gdml
/sndwrm/det/setHalfFidVol 7 7 32 m
#/sndwrm/det/setHalfFidVol 651.486 672.371 2986.371 cm
/random/setSeeds 1 11
#
/run/numberOfThreads 1
/run/initialize
#
/process/list
#
# ---------- Common source geometry (applies to source 0) ----------
/gps/particle gamma
/gps/pos/type Volume
/gps/pos/shape Para
/gps/pos/halfx 7 m
/gps/pos/halfy 7 m
/gps/pos/halfz 32 m
/gps/pos/centre 0 0 0 m
/gps/pos/confine Arapuca_place
/gps/ang/type iso
/gps/ene/type Mono
